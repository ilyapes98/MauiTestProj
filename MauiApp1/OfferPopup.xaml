<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="MauiApp1.OfferPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MauiApp1.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MauiApp1.ViewModels"
    x:DataType="vm:OfferPopupViewModel"
    x:TypeArguments="models:OfferPopupResult">

    <VerticalStackLayout BackgroundColor="{Binding BackgroundColor}">
        <Label
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            Text="{Binding Title}"
            TextColor="{Binding TextColor}" />
        <Label
            FontSize="48"
            HorizontalOptions="Center"
            Text="{Binding Symbol}"
            TextColor="{Binding TextColor}" />
        <Image
            HeightRequest="120"
            HorizontalOptions="Center"
            IsVisible="{Binding ShowIcon}"
            Source="dotnet_bot.png" />
        <Button
            Command="{Binding ClaimCommand}"
            HorizontalOptions="Center"
            Text="Claim Offer" />
    </VerticalStackLayout>

</toolkit:Popup>
